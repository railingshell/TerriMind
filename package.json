{
  "name": "terrimind-by-rogaart",
  "version": "1.0.0",
  "description": "TerriMind MVP — генерация кварталов и расчёт ТЭП",
  "main": "main.js",
  "scripts": {
    "test": "node --test --experimental-vm-modules test/",
    "test:unit": "node --test test/unit/",
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "keywords": [],
  "author": "rogaart",
  "license": "ISC",
  "type": "commonjs",
  "build": {
    "appId": "com.rogaart.terrimind",
    "productName": "TerriMind",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "js/**/*",
      "licensing.js",
      "activation-store.js",
      "activation.html",
      "activation-ui.js",
      "node_modules/leaflet/**/*",
      "node_modules/leaflet-draw/**/*",
      "node_modules/@turf/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@turf/turf": "^6.5.0",
    "leaflet": "^1.9.4",
    "leaflet-draw": "^1.0.4",
    "pdfjs-dist": "^4.7.76"
  }
}
